# 环境变量模板：只有键名与占位值，不含任何真实值。
# 用法：cp .env.example .env 后填入真实值；真实 .env 已被 .gitignore 排除。
# worktree 自动接入机制见 docs/ops/env-worktree-bootstrap.md。

# LLM
OPENAI_API_KEY=change-me
OPENAI_BASE_URL=change-me
LLM_MODEL=change-me

# 实验机器凭据（机器清单见 docs/ops/experiment-env.md）
MAC_SSH_15=change-me
MAC_LOCAL_SSH_114=change-me
LINUX_SSH_102=change-me
LINUX_SSH_138=change-me

# 云厂商
ALIBABA_CLOUD_ACCESS_KEY_ID=change-me
ALIBABA_CLOUD_ACCESS_KEY_SECRET=change-me
ALIYUN_REGION=change-me
E2B_API_KEY=change-me
E2B_DOMAIN=change-me
E2B_API_URL=change-me

# 地图服务
AMAP_API_KEY=change-me
AMAP_SECRET_KEY=change-me

# SSH 部署
SSH_HOST=change-me
SSH_USER=change-me
SSH_PASSWORD=change-me

# Gitea
GITEA_SECRET_KEY=change-me
GITEA_RUNNER_TOKEN=change-me
GITEA_DOMAIN=change-me
GITEA_DB_NAME=change-me
GITEA_DB_USER=change-me
GITEA_DB_PASSWORD=change-me
GITEA_API_URL=change-me
GITEA_TOKEN=change-me
