{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "p2p-console",
  "version": "0.1.1",
  "identifier": "com.p2p.console",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "p2p-console",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "p2p 节点可视化控制台",
    "longDescription": "本机 p2p 节点的启停与配置、邻居节点发现与连接、降级链（直连/打洞/中继）路径可视化与事件流观测。纯可视化界面，不新增协议语义。",
    "copyright": "Copyright © 2026 p2p-console contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
